// Slices -- `[]T`, the view.
//
// `[]T` is a **view** of some elements of `T`: a pointer and a length, two words,
// aliasing storage somebody else owns. It is not an array, it is not a pointer,
// and it never copies: writing through a view writes the thing it views.
//
// A view is taken from an array, from another view, or from a pointer, and the
// form says how much of it:
//
//   a[..]      the whole thing          a[..3]   up to, but not including, 3
//   a[1..]     from 1 to the end        a[1..3]  from 1 to, but not including, 3
//
// The end is **one past the last element**, so `a[0..4]` on a `[4]i32` is the
// whole object and `a[4..4]` is the empty view at its end. A view of a view
// indexes from its own start: `s[1..3][0]` is `s[1]`, never `s[0]`.
//
// A pointer is the one base with no length in any type, so it is the one base
// that has to write both bounds -- and the one whose view is unchecked, because
// the compiler has no extent to check it against. That is the form that says so
// by being written that way.

// A slice parameter is the ordinary way to pass "some of a table": two words
// cross, and the callee can read and write the elements the caller owns.
//
// The count is a parameter for now, and that is the honest spelling rather than a
// gap in the example: a view carries its length, and reading that length needs
// `len(s)`, which the language does not have yet. Until it does, the count is the
// caller's word -- which is also why a view of a *pointer* reads as the unchecked
// form, since there the compiler had no extent of its own either.
fn i32 sum(s: []i32, n: i32) {
  let total: i32 = 0;
  for let i: i32 = 0; i < n; i += 1 {
    // `s[i]` is an element of the view, which is `*(s.ptr + i)`.
    total = total + s[i];
  }
  return total;
}

fn void add_ten(s: []i32) {
  for let i: i32 = 0; i < 2; i += 1 {
    // A write through a view is a write to the array behind it.
    s[i] = s[i] + 10;
  }
}

// A slice parameter by value *and* a slice result: the descriptor crosses, so
// nothing is copied but the two words.
fn []i32 tail(s: []i32) {
  return s[1..3];
}

fn i32 main() {
  // An array is storage; the view is taken of it. Nothing is copied: the two
  // words name the array's elements.
  let table: [4]i32 = [1, 2, 3, 4];
  let all: []i32 = table[..];
  let middle: []i32 = table[1..3]; // `table[1]` and `table[2]`
  let from_two: []i32 = table[2..]; // to the end
  let up_to_two: []i32 = table[..2]; // from the start

  // The write is visible in the array, and the array's element is the one the
  // view's element is.
  add_ten(middle);
  let first: i32 = table[1];  // 12
  let second: i32 = table[2]; // 13

  // A view of a view: `inner[0]` is `middle[1]`, which is `table[2]`.
  let inner: []i32 = middle[1..2];
  let inner_first: i32 = inner[0]; // 13

  // From a pointer. Both bounds are written because a pointer has no length to
  // count back from, and the compiler promises nothing about the extent: it is
  // the caller's word -- exactly as `p[i]` is.
  let p: *i32 = &table[0];
  let first_two: []i32 = p[0..2];
  let pair: i32 = sum(first_two, 2); // 1 + 12

  // The result of a function is a view like any other, and its index 0 is its
  // own first element.
  let rest: []i32 = tail(all);
  let rest_first: i32 = rest[0]; // 12

  // Refused, each with a sentence rather than a wrong answer:
  //
  //   []i32{1, 2, 3}   a slice has no literal: a view of a temporary would be a
  //                    view of nothing, so name the object first and view it
  //   a[0..5]          a bound past the end of a `[4]i32`, where the count is in
  //                    the type and the bound is a number
  //   a[3..1]          backwards: a beginning cannot be past its own end
  //   p[..4]           a pointer with one bound: nothing to infer the other from
  //   f(a)             no decay -- an array is not a view, `f(a[..])` is
  //   extern fn f(s: []i32)  a descriptor's layout is this compiler's own, so the
  //                    boundary asks for a pointer and a length instead
  //   let x: i32 = 1; let s: []i32 = x[..]  a number has no elements to view

  return first + second + inner_first + pair + rest_first;
}
